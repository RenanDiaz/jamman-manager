{
  "name": "jamman-manager",
  "description": "JamMan patch editor and loop manager for Digitech JamMan Stereo",
  "version": "0.1.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "author": {
    "name": "Renán Díaz Reyes",
    "email": "renandiazreyes@gmail.com",
    "url": "https://github.com/renandiazreyes"
  },
  "main": "packages/entry-point.mjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -ws --if-present",
    "compile": "npm run build && electron-builder build --config electron-builder.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test ./tests/e2e.spec.ts",
    "start": "node packages/dev-mode.js",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "verify": "npm run typecheck && npm run lint && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "npm run build && electron-builder --config electron-builder.mjs",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.mjs",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.mjs",
    "dist:linux": "npm run build && electron-builder --linux --config electron-builder.mjs",
    "dist:all": "npm run build && electron-builder -mwl --config electron-builder.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@npmcli/map-workspaces": "4.0.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "22.14.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^5.1.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "glob": "11.0.3",
    "globals": "^16.4.0",
    "happy-dom": "^20.0.10",
    "playwright": "^1.65.0",
    "prettier": "^3.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@app/main": "*"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,json,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  }
}
